{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "hiprompt_share.py",
            "console": "integratedTerminal",
            "args": [
                "--height", "4096",
                "--width", "4096",
                "--model_ckpt=stabilityai/stable-diffusion-xl-base-1.0",
                "--validation_prompt", "A cute corgi on the lawn.",
                "--share", "true",
                "--scale", "true",
                "--cosine_scale_3", "0.8",
                "--noise_decom", "true",
                "--reduction", "sum",
                "--view_args", "2.0 2.0",
                "--views_type", "low_pass high_pass",
                "--guidance_scale_2", "10.0",
                // "--ngram", "true",
                // "--logging_dir", "${your-logging-dir}"
            ],
            "env": {
                "CUDA_VISIBLE_DEVICES": "6"
              }
        },
        {
            "name": "Python Debugger2",
            "type": "debugpy",
            "request": "launch",
            "program": "hiprompt_llava.py",
            "console": "integratedTerminal",
            "args": [
                "--height", "4096",
                "--width", "4096",
                "--model_ckpt=stabilityai/stable-diffusion-xl-base-1.0",
                "--validation_prompt", 
                "Astronaut on Mars During sunset.",
                // "A corgi sits on a beach chair on a beautiful beach, with palm trees behind, high details.",
                "--llava", "true",
                "--scale", "true",
                "--cosine_scale_3", "0.8",
                "--noise_decom", "true",
                "--reduction", "sum",
                "--view_args", "2.0 2.0",
                "--views_type", "low_pass high_pass",
                "--guidance_scale_2", "10.0",
                // "--ngram", "true",
                // "--logging_dir", "${your-logging-dir}"
            ],
            "env": {
                "CUDA_VISIBLE_DEVICES": "7"
              }
        }
    ]
}